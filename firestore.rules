rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Nutzer: nur eigene Daten
    match /nutzer/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Fahrer: lesen für alle eingeloggten Nutzer (Fahrgast sucht Fahrer), schreiben nur eigene Daten
    match /fahrer/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Fahrten: nur eingeloggte Nutzer
    match /fahrten/{fahrtId} {
      allow read, write: if request.auth != null;

      // Chat-Nachrichten innerhalb einer Fahrt
      match /nachrichten/{nachrichtId} {
        allow read, write: if request.auth != null;
      }
    }

    // Support-Anfragen: nur erstellen, nicht lesen
    match /support_anfragen/{docId} {
      allow create: if request.auth != null;
      allow read: if false;
    }

    // Mail: nur schreiben (Extension liest selbst)
    match /mail/{docId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

    // Admin: niemand (nur Firebase Console)
    match /admin/{document} {
      allow read, write: if false;
    }
  }
}
