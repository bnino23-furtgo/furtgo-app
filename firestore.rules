rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function istAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/nutzer/$(request.auth.uid))
        && get(/databases/$(database)/documents/nutzer/$(request.auth.uid)).data.istAdmin == true;
    }

    // Nutzer: eigene Daten lesen/schreiben. WICHTIG: istAdmin darf vom Nutzer NICHT
    // selbst gesetzt/geaendert werden (sonst Privilege Escalation -> jeder waere Admin).
    // Nur ein bestehender Admin aendert fremde Docs oder das Admin-Flag.
    match /nutzer/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || istAdmin());
      allow create: if request.auth != null && (
        (request.auth.uid == userId && request.resource.data.get('istAdmin', false) == false)
        || istAdmin());
      allow update: if request.auth != null && (
        (request.auth.uid == userId
          && request.resource.data.get('istAdmin', false) == resource.data.get('istAdmin', false))
        || istAdmin());
      allow delete: if request.auth != null && (request.auth.uid == userId || istAdmin());
    }

    // Fahrer: lesbar fuer alle eingeloggten (Fahrgast braucht Fahrerliste + Live-Standort).
    // Self-Write erlaubt, ABER sicherheits-/geldrelevante Felder eingefroren, damit ein
    // Fahrer sich nicht selbst verifizieren, entsperren oder ein Abo schenken kann:
    //  - verifiziert: darf hoechstens auf 'ausstehend' gesetzt werden (Doku-Upload), nie 'genehmigt'
    //  - gesperrt, abo, aboGueltigBis: nur Admin/Cloud Function
    match /fahrer/{userId} {
      function selfFelderOk() {
        return request.resource.data.get('gesperrt', false) == resource.data.get('gesperrt', false)
          && request.resource.data.get('aboGueltigBis', 0) == resource.data.get('aboGueltigBis', 0)
          && request.resource.data.get('abo', {}) == resource.data.get('abo', {})
          && (
            request.resource.data.get('verifiziert', '') == resource.data.get('verifiziert', '')
            || request.resource.data.get('verifiziert', '') == 'ausstehend'
          );
      }
      allow read: if request.auth != null;
      allow create: if request.auth != null && (
        (request.auth.uid == userId
          && request.resource.data.get('verifiziert', '') != 'genehmigt'
          && request.resource.data.get('gesperrt', false) == false
          && request.resource.data.get('aboGueltigBis', 0) == 0)
        || istAdmin());
      allow update: if request.auth != null && (
        (request.auth.uid == userId && selfFelderOk())
        || istAdmin());
      allow delete: if istAdmin();

      // Rechnungen: Fahrer liest eigene (Cloud Function schreibt)
      match /rechnungen/{rechnungsNr} {
        allow read: if request.auth != null && (request.auth.uid == userId || istAdmin());
        allow write: if false;
      }

      // ARV 2 Online-Events: Fahrer liest + erstellt eigene, keine Updates/Deletes (Audit-Integritaet)
      match /online_events/{eventId} {
        allow read: if request.auth != null && (request.auth.uid == userId || istAdmin());
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.istOnline is bool
          && request.resource.data.keys().hasOnly(['timestamp', 'istOnline', 'standort', 'grund']);
        allow update, delete: if false;
      }
    }

    // Fahrten: nur Beteiligte (Fahrgast / zugewiesener bzw. aktiver Fahrer) + Admin.
    // Fahrer duerfen offene 'wartend'-Anfragen LESEN (Dispatch-Modell, Client-Round-Robin)
    // und nur dann schreiben, wenn sie selbst zugewiesen/aktiv sind. Damit kann niemand mehr
    // fremde Fahrten lesen (Adressen, Preise, Chat) oder manipulieren (Status, Preis, Bewertung).
    match /fahrten/{fahrtId} {
      allow read: if request.auth != null && (
        resource.data.fahrgastId == request.auth.uid
        || resource.data.fahrerId == request.auth.uid
        || resource.data.zugewiesenerFahrerId == request.auth.uid
        || resource.data.status == 'wartend'
        || istAdmin());
      allow create: if request.auth != null
        && request.resource.data.fahrgastId == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.fahrgastId == request.auth.uid
        || resource.data.fahrerId == request.auth.uid
        || resource.data.zugewiesenerFahrerId == request.auth.uid
        || istAdmin());
      allow delete: if istAdmin();

      // Chat-Nachrichten: nur Beteiligte der zugehoerigen Fahrt
      match /nachrichten/{nachrichtId} {
        function fahrt() {
          return get(/databases/$(database)/documents/fahrten/$(fahrtId)).data;
        }
        allow read, write: if request.auth != null && (
          fahrt().fahrgastId == request.auth.uid
          || fahrt().fahrerId == request.auth.uid
          || fahrt().zugewiesenerFahrerId == request.auth.uid
          || istAdmin());
      }

      // ARV 2 Audit-Log: nur Beteiligte lesen, schreiben nur Cloud Function
      match /changes/{changeId} {
        function fahrt() {
          return get(/databases/$(database)/documents/fahrten/$(fahrtId)).data;
        }
        allow read: if request.auth != null && (
          fahrt().fahrgastId == request.auth.uid
          || fahrt().fahrerId == request.auth.uid
          || istAdmin());
        allow write: if false;
      }
    }

    // ARV 2 Schichten: Fahrer verwaltet eigene, Admin alles
    match /schichten/{schichtId} {
      allow read: if request.auth != null
        && (resource.data.fahrerId == request.auth.uid || istAdmin());
      allow create: if request.auth != null
        && (request.resource.data.fahrerId == request.auth.uid || istAdmin());
      allow update, delete: if request.auth != null
        && (resource.data.fahrerId == request.auth.uid || istAdmin());

      match /changes/{changeId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    // ARV 2 Config/Feature-Flags: alle lesen, nur Admin schreiben
    match /config/{configId} {
      allow read: if request.auth != null;
      allow write: if istAdmin();
    }

    // Support-Anfragen: nur erstellen, nicht lesen
    match /support_anfragen/{docId} {
      allow create: if request.auth != null;
      allow read: if false;
    }

    // Mail (Befund #4 GEFIXT): Clients duerfen NICHT mehr direkt schreiben.
    // Mails werden ausschliesslich server-seitig ueber die Callables in
    // functions/src/mailVersand.ts eingereiht (Admin-SDK umgeht die Rules).
    // Empfaenger + Inhalt sind dort server-kontrolliert -> kein Phishing/Spam
    // ueber support.furtgo@gmail.com mehr moeglich. Die Trigger-Email-Extension
    // liest selbst.
    match /mail/{docId} {
      allow read, create, update, delete: if false;
    }

    // Admin: niemand (nur Firebase Console)
    match /admin/{document} {
      allow read, write: if false;
    }

    // Webhook-Events: nur Cloud Function (Admin SDK bypasst Rules)
    match /webhook_events/{eventId} {
      allow read, write: if false;
    }
  }
}
