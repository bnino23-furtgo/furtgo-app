rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function istAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/nutzer/$(request.auth.uid))
        && get(/databases/$(database)/documents/nutzer/$(request.auth.uid)).data.istAdmin == true;
    }

    // Nutzer: eigene Daten, Admin darf alle lesen/schreiben
    match /nutzer/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || istAdmin());
    }

    // Fahrer: lesen für alle eingeloggten Nutzer, schreiben eigene Daten oder Admin
    match /fahrer/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || istAdmin());
    }

    // Fahrten: nur eingeloggte Nutzer
    match /fahrten/{fahrtId} {
      allow read, write: if request.auth != null;

      // Chat-Nachrichten innerhalb einer Fahrt
      match /nachrichten/{nachrichtId} {
        allow read, write: if request.auth != null;
      }

      // ARV 2 Audit-Log: Client darf lesen (nur eigene), schreiben nur Cloud Function
      match /changes/{changeId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    // ARV 2 Schichten: Fahrer verwaltet eigene, Admin alles
    match /schichten/{schichtId} {
      allow read: if request.auth != null
        && (resource.data.fahrerId == request.auth.uid || istAdmin());
      allow create: if request.auth != null
        && (request.resource.data.fahrerId == request.auth.uid || istAdmin());
      allow update, delete: if request.auth != null
        && (resource.data.fahrerId == request.auth.uid || istAdmin());

      match /changes/{changeId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    // ARV 2 Online-Events: Fahrer liest eigene, nur Cloud Function schreibt
    match /fahrer/{userId}/online_events/{eventId} {
      allow read: if request.auth != null && (request.auth.uid == userId || istAdmin());
      allow write: if false;
    }

    // ARV 2 Config/Feature-Flags: alle lesen, nur Admin schreiben
    match /config/{configId} {
      allow read: if request.auth != null;
      allow write: if istAdmin();
    }

    // Support-Anfragen: nur erstellen, nicht lesen
    match /support_anfragen/{docId} {
      allow create: if request.auth != null;
      allow read: if false;
    }

    // Mail: nur schreiben (Extension liest selbst)
    match /mail/{docId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

    // Admin: niemand (nur Firebase Console)
    match /admin/{document} {
      allow read, write: if false;
    }
  }
}
